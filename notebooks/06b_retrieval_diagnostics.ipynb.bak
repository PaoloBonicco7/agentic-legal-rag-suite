   "source": [
    "def _sample_rerank_targets(targets):\n",
    "    if RERANK_FULL_RUN or len(targets) <= RERANK_QUESTION_SAMPLE:\n",
    "        return list(targets)\n",
    "    rng = random.Random(RERANK_SAMPLE_SEED)\n",
    "    return rng.sample(list(targets), RERANK_QUESTION_SAMPLE)\n",
    "\n",
    "\n",
    "def _best_hybrid_rrf_k(dataset: str) -> int | None:\n",
    "    if not hybrid_available:\n",
    "        return None\n",
    "    subset = direct_summary[\n",
    "        (direct_summary[\"dataset\"] == dataset)\n",
    "        & (direct_summary[\"retrieval_mode\"] == \"hybrid\")\n",
    "        & (direct_summary[\"filter_name\"] == \"none\")\n",
    "    ].copy()\n",
    "    if subset.empty:\n",
    "        return None\n",
    "    winner = subset.sort_values([\"article_hit\", \"article_mrr\", \"top_k\", \"rrf_k\"], ascending=[False, False, True, True]).iloc[0]\n",
    "    return int(winner[\"rrf_k\"])\n",
    "\n",
    "\n",
    "rerank_rows: list[dict[str, Any]] = []\n",
    "rerank_model_name: str | None = None\n",
    "rerank_runtime: dict[str, Any] | None = None\n",
    "rerank_cache_file: Path | None = None\n",
    "rerank_cache_hits = 0\n",
    "rerank_cache_misses = 0\n",
    "rerank_failures: list[dict[str, Any]] = []\n",
    "rerank_failure_rate = 0.0\n",
    "rerank_summary = pd.DataFrame()\n",
    "rerank_impact_df = pd.DataFrame()\n",
    "\n",
    "if RUN_RERANK:\n",
    "    if not hybrid_available:\n",
    "        mark_experiment(\"llm_rerank\", status=\"skipped\", reason=\"Hybrid retrieval unavailable; rerank G depends on best hybrid\")\n",
    "    else:\n",
    "        llm_client, rerank_model_name, rerank_runtime = create_diagnostic_llm_client()\n",
    "        rerank_cache_file = rerank_cache_path(PROJECT_ROOT / \"data\" / \"cache\", model=rerank_model_name)\n",
    "        rerank_cache = RerankCache(rerank_cache_file)\n",
    "        rerank_iter = datasets_in_run\n",
    "        if SHOW_PROGRESS:\n",
    "            try:\n",
    "                from tqdm.auto import tqdm\n",
    "                rerank_iter = tqdm(rerank_iter, desc=\"rerank datasets\")\n",
    "            except ImportError:\n",
    "                pass\n",
    "        for dataset in rerank_iter:\n",
    "            base_rrf_k = _best_hybrid_rrf_k(dataset)\n",
    "            if base_rrf_k is None:\n",
    "                continue\n",
    "            selected_targets = _sample_rerank_targets(targets_by_dataset[dataset])\n",
    "            for target in selected_targets:\n",
    "                for rerank_input_k in RERANK_INPUT_K_VALUES:\n",
    "                    candidates = _get_direct_candidates(\n",
    "                        dataset,\n",
    "                        target,\n",
    "                        retrieval_mode=\"hybrid\",\n",
    "                        top_k=rerank_input_k,\n",
    "                        rrf_k=base_rrf_k,\n",
    "                        filter_name=\"none\",\n",
    "                        filters={},\n",
    "                    )[:rerank_input_k]\n",
    "                    try:\n",
    "                        scores, cache_hit = score_rerank_candidates(\n",
    "                            llm_client=llm_client,\n",
    "                            question=target.question,\n",
    "                            candidates=candidates,\n",
    "                            model=rerank_model_name,\n",
    "                            timeout_seconds=CONFIG.timeout_seconds,\n",
    "                            cache=rerank_cache,\n",
    "                            prompt_version=RERANK_PROMPT_VERSION,\n",
    "                        )\n",
    "                    except Exception as exc:\n",
    "                        rerank_failures.append({\n",
    "                            \"dataset\": dataset,\n",
    "                            \"qid\": target.qid,\n",
    "                            \"rerank_input_k\": rerank_input_k,\n",
    "                            \"error\": f\"{type(exc).__name__}: {exc}\",\n",
    "                        })\n",
    "                        continue\n",
    "                    rerank_cache_hits += int(cache_hit)\n",
    "                    rerank_cache_misses += int(not cache_hit)\n",
    "                    for rerank_output_k in RERANK_OUTPUT_K_VALUES:\n",
    "                        row = evaluate_with_rerank(\n",
    "                            target=target,\n",
    "                            candidates=candidates,\n",
    "                            scores=scores,\n",
    "                            rerank_input_k=rerank_input_k,\n",
    "                            rerank_output_k=rerank_output_k,\n",
    "                            retrieval_mode=\"hybrid\",\n",
    "                            top_k=rerank_input_k,\n",
    "                            rrf_k=base_rrf_k,\n",
    "                            filter_name=\"none\",\n",
    "                            metadata_filters={},\n",
    "                            base_scenario=\"hybrid_if_available\",\n",
    "                            rerank_model=rerank_model_name,\n",
    "                            cache_hit=cache_hit,\n",
    "                        ).to_json_record()\n",
    "                        row[\"dataset\"] = dataset\n",
    "                        row[\"prompt_version\"] = RERANK_PROMPT_VERSION\n",
    "                        rerank_rows.append(row)\n",
    "        if rerank_failures:\n",
    "            rerank_failure_rate = len(rerank_failures) / max(1, len(rerank_failures) + rerank_cache_hits + rerank_cache_misses)\n",
    "            display(pd.DataFrame(rerank_failures).head(20))\n",
    "            if rerank_failure_rate > RERANK_FAILURE_RATE_WARN_THRESHOLD:\n",
    "                display(Markdown(\n",
    "                    f\"**Warning rerank:** structured-output failures al {rerank_failure_rate:.1%}. \"\n",
    "                    \"Il notebook continua e salva le righe riuscite; interpreta il rerank come pilot parziale.\"\n",
    "                ))\n",
    "            if RERANK_STRICT_FAILURES and rerank_failure_rate > RERANK_FAILURE_RATE_WARN_THRESHOLD:\n",
    "                raise RuntimeError(f\"Structured-output failures above threshold: {rerank_failure_rate:.1%}\")\n",
    "        mark_experiment(\n",
    "            \"llm_rerank\",\n",
    "            status=\"run\" if rerank_rows else \"skipped\",\n",
    "            reason=\"\" if rerank_rows else \"No rerank rows produced\",\n",
    "            rows=len(rerank_rows),\n",
    "            extra={\n",
    "                \"cache_path\": str(rerank_cache_file),\n",
    "                \"cache_hits\": rerank_cache_hits,\n",
    "                \"cache_misses\": rerank_cache_misses,\n",
    "                \"failure_rate\": rerank_failure_rate,\n",
    "                \"failures\": len(rerank_failures),\n",
    "            },\n",
    "        )\n",
    "else:\n",
    "    mark_experiment(\"llm_rerank\", status=\"skipped\", reason=\"RUN_RERANK=False\")\n",
    "\n",
    "rerank_df = pd.DataFrame(rerank_rows)\n",
    "if rerank_df.empty:\n",
    "    display_experiment_card(\"Esperimento G - LLM rerank\", status=\"skipped\", metric=\"article_hit@5\", note=\"Impostare RUN_RERANK=True per eseguire il pilot versionato e cache-aware.\")\n",
    "else:\n",
    "    rerank_summary = (\n",
    "        rerank_df.groupby([\"dataset\", \"retrieval_mode\", \"top_k\", \"rrf_k\", \"rerank_input_k\", \"rerank_output_k\", \"rerank_model\"], dropna=False)\n",
    "        .agg(\n",
    "            questions=(\"qid\", \"nunique\"),\n",
    "            article_hit=(\"reranked_article_hit\", \"mean\"),\n",
    "            law_hit=(\"reranked_law_hit\", \"mean\"),\n",
    "            article_mrr=(\"reranked_article_mrr\", \"mean\"),\n",
    "            pre_article_hit=(\"pre_rerank_article_hit\", \"mean\"),\n",
    "            pre_article_mrr=(\"pre_rerank_first_article_rank\", lambda values: float((values.dropna().rdiv(1)).mean()) if len(values.dropna()) else 0.0),\n",
    "            cache_hit_rate=(\"cache_hit\", \"mean\"),\n",
    "            recovered=(\"rerank_recovered_article\", \"sum\"),\n",
    "            demoted=(\"rerank_demoted_article\", \"sum\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "    rerank_summary[\"delta_vs_pre_article_hit\"] = rerank_summary[\"article_hit\"] - rerank_summary[\"pre_article_hit\"]\n",
    "    rerank_summary[\"net_recovered\"] = rerank_summary[\"recovered\"] - rerank_summary[\"demoted\"]\n",
    "    rerank_impact_df = (\n",
    "        rerank_summary.sort_values(\n",
    "            [\"dataset\", \"article_hit\", \"delta_vs_pre_article_hit\", \"article_mrr\", \"rerank_input_k\", \"rerank_output_k\"],\n",
    "            ascending=[True, False, False, False, True, True],\n",
    "        )\n",
    "        .groupby(\"dataset\", group_keys=False)\n",
    "        .head(1)\n",
    "        .reset_index(drop=True)\n",
    "    )\n",
    "    display_experiment_card(\n",
    "        \"Esperimento G - LLM rerank\",\n",
    "        status=\"run\",\n",
    "        metric=\"article_hit@5 post-rerank\",\n",
    "        config={\"prompt_version\": RERANK_PROMPT_VERSION, \"cache\": str(rerank_cache_file)},\n",
    "    )\n",
    "    display(rerank_summary.sort_values([\"dataset\", \"article_hit\", \"delta_vs_pre_article_hit\", \"article_mrr\", \"rerank_input_k\"], ascending=[True, False, False, False, True]))\n",
    "    display(Markdown(\"**Migliore configurazione rerank per dataset (delta rispetto alla stessa candidate list pre-rerank):**\"))\n",
    "    display(rerank_impact_df[[\n",
    "        \"dataset\", \"rerank_input_k\", \"rerank_output_k\", \"rrf_k\", \"questions\",\n",
    "        \"pre_article_hit\", \"article_hit\", \"delta_vs_pre_article_hit\", \"article_mrr\",\n",
    "        \"recovered\", \"demoted\", \"net_recovered\", \"cache_hit_rate\",\n",
    "    ]])\n",
    "    display(Markdown(f\"Rerank cache: `{rerank_cache_file}`; hits={rerank_cache_hits}, misses={rerank_cache_misses}\"))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f5f56e30",
   "metadata": {},
   "source": [
    "## Esperimento H - Query rewriting / HyDE / multi-query\n",
    "\n",
    "Il pilot confronta domanda originale, rewrite, HyDE e multi-query sul miglior assetto hybrid disponibile. Le chiamate LLM restano disattivate di default e usano cache versionata quando il flag viene attivato.\n"
   ]
  },
