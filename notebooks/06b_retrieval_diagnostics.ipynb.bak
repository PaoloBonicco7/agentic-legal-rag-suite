   "source": [
    "evaluation_dir = Path(CONFIG.evaluation_dir)\n",
    "laws_dir = Path(CONFIG.laws_dir)\n",
    "experiment_records = experiment_map_df().to_dict(\"records\")\n",
    "manifest = {\n",
    "    \"schema_version\": RETRIEVAL_EVALUATION_SCHEMA_VERSION,\n",
    "    \"run_name\": RUN_NAME,\n",
    "    \"diagnostic_profile\": DIAGNOSTIC_PROFILE,\n",
    "    \"benchmark_size\": BENCHMARK_SIZE,\n",
    "    \"selected_datasets\": list(DATASET_SPECS),\n",
    "    \"question_equivalence_summary\": question_equivalence_summary,\n",
    "    \"collection_name\": collection_name,\n",
    "    \"index_manifest_path\": str(index_manifest_path),\n",
    "    \"embedding_model\": getattr(base_embedder, \"model_name\", None),\n",
    "    \"dense_cache_size\": embedder.dense_cache_size,\n",
    "    \"sparse_cache_size\": embedder.sparse_cache_size,\n",
    "    \"hybrid_available\": hybrid_available,\n",
    "    \"retrieval_modes\": retrieval_modes,\n",
    "    \"graph_expansion_backend\": GRAPH_EXPANSION_BACKEND,\n",
    "    \"n_questions\": {dataset: len(targets) for dataset, targets in targets_by_dataset.items()},\n",
    "    \"sweep_dimensions\": {\n",
    "        \"top_k\": TOP_K_VALUES,\n",
    "        \"hybrid_top_k\": HYBRID_TOP_K_VALUES,\n",
    "        \"hybrid_rrf_k\": HYBRID_RRF_K_VALUES,\n",
    "        \"filters\": list(FILTER_VARIANTS.keys()),\n",
    "        \"graph_seed_k\": GRAPH_SEED_K_VALUES,\n",
    "        \"max_chunks_per_law\": MAX_CHUNKS_PER_EXPANDED_LAW_VALUES,\n",
    "        \"min_edge_confidence\": MIN_EDGE_CONFIDENCE_VALUES,\n",
    "        \"relation_sets\": list(RELATION_TYPE_VARIANTS.keys()),\n",
    "        \"graph_base_configs\": GRAPH_BASE_CONFIG_NAMES,\n",
    "        \"graph_expand_only_problem_cases\": GRAPH_EXPAND_ONLY_PROBLEM_CASES,\n",
    "        \"graph_modes\": GRAPH_RETRIEVAL_MODE_NAMES,\n",
    "        \"graph_filters\": GRAPH_FILTER_NAMES,\n",
    "        \"graph_top_k\": GRAPH_TOP_K_VALUES,\n",
    "        \"graph_relation_sets\": GRAPH_RELATION_SET_NAMES,\n",
    "    },\n",
    "    \"rerank\": {\n",
    "        \"enabled\": RUN_RERANK,\n",
    "        \"provider\": LLM_PROVIDER,\n",
    "        \"runtime\": rerank_runtime if RUN_RERANK else None,\n",
    "        \"model\": rerank_model_name,\n",
    "        \"prompt_version\": RERANK_PROMPT_VERSION,\n",
    "        \"input_k_values\": RERANK_INPUT_K_VALUES,\n",
    "        \"output_k_values\": RERANK_OUTPUT_K_VALUES,\n",
    "        \"sample\": RERANK_QUESTION_SAMPLE if RUN_RERANK and not RERANK_FULL_RUN else \"full\",\n",
    "        \"cache_path\": str(rerank_cache_file) if rerank_cache_file else None,\n",
    "        \"cache_hits\": rerank_cache_hits,\n",
    "        \"cache_misses\": rerank_cache_misses,\n",
    "        \"structured_failures\": len(rerank_failures),\n",
    "        \"failure_rate\": rerank_failure_rate,\n",
    "        \"strict_failures\": RERANK_STRICT_FAILURES,\n",
    "        \"failure_warn_threshold\": RERANK_FAILURE_RATE_WARN_THRESHOLD,\n",
    "        \"best_impact\": rerank_impact_df.to_dict(\"records\") if not rerank_impact_df.empty else [],\n",
    "    },\n",
    "    \"query_rewriting\": {\n",
    "        \"enabled\": RUN_QUERY_REWRITING,\n",
    "        \"provider\": LLM_PROVIDER,\n",
    "        \"runtime\": query_rewrite_runtime if RUN_QUERY_REWRITING else None,\n",
    "        \"model\": query_rewrite_model_name,\n",
    "        \"prompt_version\": QUERY_REWRITING_PROMPT_VERSION,\n",
    "        \"strategies\": QUERY_REWRITING_STRATEGIES,\n",
    "        \"sample\": QUERY_REWRITING_QUESTION_SAMPLE if RUN_QUERY_REWRITING and not QUERY_REWRITING_FULL_RUN else \"full\",\n",
    "        \"multi_query_n\": MULTI_QUERY_N,\n",
    "        \"cache_paths\": {strategy: str(path) for strategy, path in query_rewrite_cache_files.items()},\n",
    "        \"cache_hits\": query_rewrite_cache_hits,\n",
    "        \"cache_misses\": query_rewrite_cache_misses,\n",
    "        \"structured_failures\": len(query_rewrite_failures),\n",
    "        \"failure_rate\": query_rewrite_failure_rate,\n",
    "        \"strict_failures\": QUERY_REWRITING_STRICT_FAILURES,\n",
    "        \"failure_warn_threshold\": QUERY_REWRITING_FAILURE_RATE_WARN_THRESHOLD,\n",
    "    },\n",
    "    \"advanced_config_recommendation\": advanced_config_recommendation,\n",
    "    \"experiments\": experiment_records,\n",
    "    \"source_hashes\": {\n",
    "        \"chunks\": sha256_file(laws_dir / \"chunks.jsonl\"),\n",
    "        \"edges\": sha256_file(laws_dir / \"edges.jsonl\"),\n",
    "        \"questions_mcq\": sha256_file(evaluation_dir / \"questions_mcq.jsonl\"),\n",
    "        \"questions_no_hint\": sha256_file(evaluation_dir / \"questions_no_hint.jsonl\"),\n",
    "        \"index_manifest\": sha256_file(index_manifest_path),\n",
    "    },\n",
    "}\n",
    "\n",
    "output_dir = _unique_output_dir(OUTPUT_DIR)\n",
    "if output_dir != OUTPUT_DIR:\n",
    "    display(Markdown(f\"Output dir gia' presente; uso `{output_dir}` per non sovrascrivere run esistenti.\"))\n",
    "\n",
    "output_path = write_run_artifacts(\n",
    "    output_dir,\n",
    "    scenarios=scenarios_df.to_dict(\"records\"),\n",
    "    sweep_direct=direct_df.to_dict(\"records\"),\n",
    "    sweep_graph=graph_df.to_dict(\"records\") if not graph_df.empty else [],\n",
    "    sweep_rerank=rerank_df.to_dict(\"records\") if not rerank_df.empty else [],\n",
    "    sweep_query_rewriting=query_rewrite_df.to_dict(\"records\") if not query_rewrite_df.empty else [],\n",
    "    manifest=manifest,\n",
    ")\n",
    "if not rerank_summary.empty:\n",
    "    rerank_summary.to_csv(output_path / \"rerank_summary.csv\", index=False)\n",
    "    rerank_impact_df.to_csv(output_path / \"rerank_best_impact.csv\", index=False)\n",
    "if rerank_failures:\n",
    "    pd.DataFrame(rerank_failures).to_csv(output_path / \"rerank_failures.csv\", index=False)\n",
    "if query_rewrite_failures:\n",
    "    pd.DataFrame(query_rewrite_failures).to_csv(output_path / \"query_rewriting_failures.csv\", index=False)\n",
    "if advanced_config_recommendation:\n",
    "    advanced_config_recommendation[\"source_run_dir\"] = str(output_path)\n",
    "    write_json(output_path / \"recommended_advanced_config.json\", advanced_config_recommendation)\n",
    "\n",
    "write_json(output_path / \"experiment_map.json\", {\n",
    "    \"schema_version\": RETRIEVAL_EVALUATION_SCHEMA_VERSION,\n",
    "    \"run_name\": RUN_NAME,\n",
    "    \"created_at\": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\"),\n",
    "    \"query_rewriting\": {\n",
    "        \"enabled\": RUN_QUERY_REWRITING,\n",
    "        \"provider\": LLM_PROVIDER,\n",
    "        \"runtime\": query_rewrite_runtime if RUN_QUERY_REWRITING else None,\n",
    "        \"model\": query_rewrite_model_name,\n",
    "        \"prompt_version\": QUERY_REWRITING_PROMPT_VERSION,\n",
    "        \"strategies\": QUERY_REWRITING_STRATEGIES,\n",
    "        \"sample\": QUERY_REWRITING_QUESTION_SAMPLE if RUN_QUERY_REWRITING and not QUERY_REWRITING_FULL_RUN else \"full\",\n",
    "        \"multi_query_n\": MULTI_QUERY_N,\n",
    "        \"cache_paths\": {strategy: str(path) for strategy, path in query_rewrite_cache_files.items()},\n",
    "        \"cache_hits\": query_rewrite_cache_hits,\n",
    "        \"cache_misses\": query_rewrite_cache_misses,\n",
    "        \"structured_failures\": len(query_rewrite_failures),\n",
    "        \"failure_rate\": query_rewrite_failure_rate,\n",
    "        \"strict_failures\": QUERY_REWRITING_STRICT_FAILURES,\n",
    "        \"failure_warn_threshold\": QUERY_REWRITING_FAILURE_RATE_WARN_THRESHOLD,\n",
    "    },\n",
    "    \"advanced_config_recommendation\": advanced_config_recommendation,\n",
    "    \"experiments\": experiment_records,\n",
    "})\n",
    "\n",
    "display(Markdown(f\"Run salvato in `{output_path}`\"))\n",
    "display(Markdown(f\"- scenarios: {len(scenarios_df)} righe\"))\n",
    "display(Markdown(f\"- sweep_direct: {len(direct_df)} righe\"))\n",
    "display(Markdown(f\"- sweep_graph: {len(graph_df)} righe\"))\n",
    "display(Markdown(f\"- sweep_rerank: {len(rerank_df)} righe\"))\n",
    "display(Markdown(f\"- sweep_query_rewriting: {len(query_rewrite_df)} righe\"))\n",
    "if not rerank_summary.empty:\n",
    "    display(Markdown(\"- rerank_summary e rerank_best_impact: salvati\"))\n",
    "if rerank_failures:\n",
    "    display(Markdown(f\"- rerank_failures: {len(rerank_failures)} righe salvate\"))\n",
    "if query_rewrite_failures:\n",
    "    display(Markdown(f\"- query_rewriting_failures: {len(query_rewrite_failures)} righe salvate\"))\n",
    "if advanced_config_recommendation:\n",
    "    display(Markdown(\"- recommended_advanced_config: salvata\"))\n",
    "display(Markdown(\"- experiment_map: salvata\"))\n"
   ]
  }
 ],
