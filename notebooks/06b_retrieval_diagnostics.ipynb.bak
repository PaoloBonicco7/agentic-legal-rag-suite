       "  'INSERTED_BY'],\n",
       " 'max_chunks_per_expanded_law': 2,\n",
       " 'max_expanded_chunks_total': 15,\n",
       " 'min_edge_confidence': 0.45,\n",
       " 'rerank_enabled': False,\n",
       " 'rerank_input_k': 50,\n",
