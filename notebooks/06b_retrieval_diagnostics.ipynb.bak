   "source": [
    "\n",
    "def _scenario(dataset: str, experiment_name: str) -> pd.Series | None:\n",
    "    subset = scenarios_df[\n",
    "        (scenarios_df[\"dataset\"] == dataset)\n",
    "        & (scenarios_df[\"experiment_name\"] == experiment_name)\n",
    "        & (scenarios_df[\"status\"] == \"run\")\n",
    "        & (scenarios_df[\"article_hit_pct\"].notna())\n",
    "    ].copy()\n",
    "    if subset.empty:\n",
    "        return None\n",
    "    return subset.sort_values([\"article_hit_pct\", \"article_mrr\", \"law_hit_pct\"], ascending=[False, False, False]).iloc[0]\n",
    "\n",
    "\n",
    "def _cfg(row: pd.Series | None) -> dict[str, Any]:\n",
    "    value = row.get(\"config\") if row is not None else {}\n",
    "    return value if isinstance(value, dict) else {}\n",
    "\n",
    "\n",
    "def _gain(candidate: pd.Series | None, baseline: pd.Series | None) -> float | None:\n",
    "    if candidate is None or baseline is None:\n",
    "        return None\n",
    "    return float(candidate[\"article_hit_pct\"]) - float(baseline[\"article_hit_pct\"])\n",
    "\n",
    "\n",
    "recommendation_rows: list[dict[str, Any]] = []\n",
    "advanced_config_recommendation: dict[str, Any] | None = None\n",
    "for dataset in datasets_in_run:\n",
    "    dense_best = _scenario(dataset, \"dense_topk_curve\")\n",
    "    hybrid_best = _scenario(dataset, \"hybrid_if_available\")\n",
    "    base_retrieval = hybrid_best if hybrid_best is not None and (dense_best is None or float(hybrid_best[\"article_hit_pct\"]) >= float(dense_best[\"article_hit_pct\"])) else dense_best\n",
    "    base_cfg = _cfg(base_retrieval)\n",
    "    base_hit = float(base_retrieval[\"article_hit_pct\"]) if base_retrieval is not None else None\n",
    "\n",
    "    filter_best = _scenario(dataset, \"best_filter_from_sweep\")\n",
    "    graph_best = _scenario(dataset, \"best_graph_low_noise\")\n",
    "    query_best = _scenario(dataset, \"query_rewriting\")\n",
    "    rerank_best = _scenario(dataset, \"llm_rerank\")\n",
    "\n",
    "    graph_gain = _gain(graph_best, base_retrieval)\n",
    "    query_gain = _gain(query_best, base_retrieval)\n",
    "    rerank_gain = _gain(rerank_best, base_retrieval)\n",
    "\n",
    "    graph_cfg = _cfg(graph_best)\n",
    "    query_cfg = _cfg(query_best)\n",
    "    rerank_cfg = _cfg(rerank_best)\n",
    "\n",
    "    promote_graph = bool(\n",
    "        graph_best is not None\n",
    "        and graph_gain is not None\n",
    "        and graph_gain >= MIN_PROMOTION_GAIN_PP\n",
    "        and int(graph_best.get(\"n_filter_excluded\") or 0) == 0\n",
    "    )\n",
    "    promote_query = bool(\n",
    "        query_best is not None\n",
    "        and query_gain is not None\n",
    "        and query_gain >= MIN_PROMOTION_GAIN_PP\n",
    "        and query_cfg.get(\"strategy\") not in {None, \"none\"}\n",
    "        and query_rewrite_failure_rate <= QUERY_REWRITING_FAILURE_RATE_WARN_THRESHOLD\n",
    "    )\n",
    "\n",
    "    rerank_impact = rerank_impact_df[rerank_impact_df[\"dataset\"] == dataset] if not rerank_impact_df.empty else pd.DataFrame()\n",
    "    rerank_is_stable = bool(\n",
    "        not rerank_impact.empty\n",
    "        and float(rerank_impact.iloc[0].get(\"delta_vs_pre_article_hit\", 0.0)) >= 0.0\n",
    "        and int(rerank_impact.iloc[0].get(\"demoted\", 0)) == 0\n",
    "        and rerank_failure_rate <= RERANK_FAILURE_RATE_WARN_THRESHOLD\n",
    "    )\n",
    "    promote_rerank = bool(rerank_best is not None and rerank_is_stable)\n",
    "\n",
    "    filter_cfg = _cfg(filter_best)\n",
    "    use_filter = bool(\n",
    "        filter_best is not None\n",
    "        and filter_cfg.get(\"filter\") not in {None, \"none\"}\n",
    "        and _gain(filter_best, _scenario(dataset, \"dense_baseline_top10\")) is not None\n",
    "        and _gain(filter_best, _scenario(dataset, \"dense_baseline_top10\")) >= MIN_PROMOTION_GAIN_PP\n",
    "        and int(filter_best.get(\"n_filter_excluded\") or 0) == 0\n",
    "    )\n",
    "\n",
    "    config = {\n",
    "        \"metadata_filters_enabled\": use_filter,\n",
    "        \"static_filters\": FILTER_VARIANTS.get(str(filter_cfg.get(\"filter\")), {}) if use_filter else {},\n",
    "        \"hybrid_enabled\": base_cfg.get(\"retrieval_mode\") == \"hybrid\",\n",
    "        \"top_k\": int(base_cfg.get(\"top_k\", CONFIG.top_k)),\n",
    "        \"rrf_k\": int(base_cfg.get(\"rrf_k\", CONFIG.rrf_k) or CONFIG.rrf_k),\n",
    "        \"graph_expansion_enabled\": promote_graph,\n",
    "        \"graph_expansion_seed_k\": int(graph_cfg.get(\"seed_k\", CONFIG.graph_expansion_seed_k)),\n",
    "        \"graph_expansion_relation_types\": RELATION_TYPE_VARIANTS.get(str(graph_cfg.get(\"relations\", \"default\")), CONFIG.graph_expansion_relation_types),\n",
    "        \"max_chunks_per_expanded_law\": int(graph_cfg.get(\"max_chunks_per_law\", CONFIG.max_chunks_per_expanded_law)),\n",
    "        \"max_expanded_chunks_total\": CONFIG.max_expanded_chunks_total,\n",
    "        \"min_edge_confidence\": float(graph_cfg.get(\"min_confidence\", CONFIG.min_edge_confidence)),\n",
    "        \"rerank_enabled\": promote_rerank,\n",
    "        \"rerank_input_k\": int(rerank_cfg.get(\"rerank_input_k\", min(int(base_cfg.get(\"top_k\", CONFIG.top_k)), 50))),\n",
    "        \"rerank_output_k\": int(rerank_cfg.get(\"rerank_output_k\", CONFIG.rerank_output_k)),\n",
    "    }\n",
    "    evidence = {\n",
    "        \"dataset\": dataset,\n",
    "        \"base_retrieval_scenario\": None if base_retrieval is None else str(base_retrieval[\"scenario_name\"]),\n",
    "        \"base_article_hit_pct\": base_hit,\n",
    "        \"graph_gain_pp\": graph_gain,\n",
    "        \"query_rewriting_gain_pp\": query_gain,\n",
    "        \"rerank_gain_pp_vs_dense10_baseline\": rerank_gain,\n",
    "        \"rerank_failure_rate\": rerank_failure_rate,\n",
    "        \"query_rewriting_failure_rate\": query_rewrite_failure_rate,\n",
    "        \"promote_graph\": promote_graph,\n",
    "        \"promote_query_rewriting\": promote_query,\n",
    "        \"promote_rerank\": promote_rerank,\n",
    "        \"promote_filter\": use_filter,\n",
    "        \"query_rewriting_strategy\": str(query_cfg.get(\"strategy\", \"none\")) if promote_query else \"none\",\n",
    "        \"query_rewriting_note\": \"Not included in recommended_advanced_config because AdvancedRagConfig does not expose query rewriting fields yet.\",\n",
    "        \"recommended_config\": config,\n",
    "    }\n",
    "    recommendation_rows.append(evidence)\n",
    "\n",
    "if recommendation_rows:\n",
    "    advanced_config_recommendation = {\n",
    "        \"schema_version\": RETRIEVAL_EVALUATION_SCHEMA_VERSION,\n",
    "        \"created_at\": datetime.now(timezone.utc).replace(microsecond=0).isoformat().replace(\"+00:00\", \"Z\"),\n",
    "        \"diagnostic_profile\": DIAGNOSTIC_PROFILE,\n",
    "        \"min_promotion_gain_pp\": MIN_PROMOTION_GAIN_PP,\n",
    "        \"dataset_recommendations\": recommendation_rows,\n",
    "        \"recommended_advanced_config\": recommendation_rows[0][\"recommended_config\"],\n",
    "        \"query_rewriting_recommendation\": {\n",
    "            \"enabled\": bool(recommendation_rows[0][\"promote_query_rewriting\"]),\n",
    "            \"strategy\": recommendation_rows[0][\"query_rewriting_strategy\"],\n",
    "            \"note\": \"Diagnostic evidence only; add AdvancedRagConfig/runner support before applying it to notebook 06.\",\n",
    "        },\n",
    "        \"selection_note\": \"Retrieval-only recommendation. Run notebook 06 smoke before full final analysis.\",\n",
    "    }\n",
    "    display(Markdown(\"**Configurazione candidata per `06_advanced_graph_rag.ipynb`:**\"))\n",
    "    display(pd.DataFrame(recommendation_rows).drop(columns=[\"recommended_config\"]))\n",
    "    display(advanced_config_recommendation[\"recommended_advanced_config\"])\n",
    "else:\n",
    "    display(Markdown(\"_Nessuna raccomandazione prodotta: mancano scenari eseguiti._\"))\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "dc696628",
   "metadata": {},
   "source": [
    "## Dashboard Matplotlib - performance per tecnica e parametri\n",
    "\n",
    "Questa sezione e' pensata per il colpo d'occhio: ogni dataset ha una figura 2x2 che mostra curve direct, scenari nominati, migliori configurazioni graph e tradeoff rumore/guadagno. I label includono i parametri essenziali per leggere subito quale tecnica produce la performance osservata.\n"
   ]
  },
