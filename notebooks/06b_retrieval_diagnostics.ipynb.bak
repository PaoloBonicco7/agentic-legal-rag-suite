   "source": [
    "def _sample_query_rewrite_targets(targets):\n",
    "    if QUERY_REWRITING_FULL_RUN or len(targets) <= QUERY_REWRITING_QUESTION_SAMPLE:\n",
    "        return list(targets)\n",
    "    rng = random.Random(QUERY_REWRITING_SAMPLE_SEED)\n",
    "    return rng.sample(list(targets), QUERY_REWRITING_QUESTION_SAMPLE)\n",
    "\n",
    "\n",
    "def _best_hybrid_config(dataset: str) -> tuple[int, int] | None:\n",
    "    if not hybrid_available:\n",
    "        return None\n",
    "    subset = direct_summary[\n",
    "        (direct_summary[\"dataset\"] == dataset)\n",
    "        & (direct_summary[\"retrieval_mode\"] == \"hybrid\")\n",
    "        & (direct_summary[\"filter_name\"] == \"none\")\n",
    "    ].copy()\n",
    "    if subset.empty:\n",
    "        return None\n",
    "    winner = subset.sort_values([\"article_hit\", \"article_mrr\", \"top_k\", \"rrf_k\"], ascending=[False, False, True, True]).iloc[0]\n",
    "    return int(winner[\"top_k\"]), int(winner[\"rrf_k\"])\n",
    "\n",
    "\n",
    "query_rewrite_rows: list[dict[str, Any]] = []\n",
    "query_rewrite_model_name: str | None = None\n",
    "query_rewrite_runtime: dict[str, Any] | None = None\n",
    "query_rewrite_cache_files: dict[str, Path] = {}\n",
    "query_rewrite_cache_hits = 0\n",
    "query_rewrite_cache_misses = 0\n",
    "query_rewrite_failures: list[dict[str, Any]] = []\n",
    "query_rewrite_examples: list[dict[str, Any]] = []\n",
    "query_rewrite_failure_rate = 0.0\n",
    "\n",
    "if RUN_QUERY_REWRITING:\n",
    "    if not hybrid_available:\n",
    "        mark_experiment(\"query_rewriting\", status=\"skipped\", reason=\"Hybrid retrieval unavailable; query rewriting H depends on best hybrid\")\n",
    "    else:\n",
    "        llm_client, query_rewrite_model_name, query_rewrite_runtime = create_diagnostic_llm_client()\n",
    "        rewrite_caches = {\n",
    "            strategy: QueryRewriteCache(\n",
    "                query_rewrite_cache_path(\n",
    "                    PROJECT_ROOT / \"data\" / \"cache\",\n",
    "                    strategy=strategy,\n",
    "                    model=query_rewrite_model_name,\n",
    "                    prompt_version=QUERY_REWRITING_PROMPT_VERSION,\n",
    "                )\n",
    "            )\n",
    "            for strategy in QUERY_REWRITING_STRATEGIES\n",
    "            if strategy != \"none\"\n",
    "        }\n",
    "        query_rewrite_cache_files = {strategy: cache.path for strategy, cache in rewrite_caches.items()}\n",
    "        for dataset in datasets_in_run:\n",
    "            base_config = _best_hybrid_config(dataset)\n",
    "            if base_config is None:\n",
    "                continue\n",
    "            base_top_k, base_rrf_k = base_config\n",
    "            selected_targets = _sample_query_rewrite_targets(targets_by_dataset[dataset])\n",
    "            for target in selected_targets:\n",
    "                for strategy in QUERY_REWRITING_STRATEGIES:\n",
    "                    try:\n",
    "                        if strategy == \"none\":\n",
    "                            transformed_queries = [target.question]\n",
    "                            cache_hit = True\n",
    "                            model_name = None\n",
    "                            prompt_version = None\n",
    "                        elif strategy == \"rewrite\":\n",
    "                            result = rewrite_query(\n",
    "                                llm_client=llm_client,\n",
    "                                question=target.question,\n",
    "                                model=query_rewrite_model_name,\n",
    "                                timeout_seconds=CONFIG.timeout_seconds,\n",
    "                                cache=rewrite_caches[strategy],\n",
    "                                prompt_version=QUERY_REWRITING_PROMPT_VERSION,\n",
    "                            )\n",
    "                            transformed_queries = result.queries\n",
    "                            cache_hit = result.cache_hit\n",
    "                            model_name = result.model\n",
    "                            prompt_version = result.prompt_version\n",
    "                        elif strategy == \"hyde\":\n",
    "                            result = generate_hyde(\n",
    "                                llm_client=llm_client,\n",
    "                                question=target.question,\n",
    "                                model=query_rewrite_model_name,\n",
    "                                timeout_seconds=CONFIG.timeout_seconds,\n",
    "                                cache=rewrite_caches[strategy],\n",
    "                                prompt_version=QUERY_REWRITING_PROMPT_VERSION,\n",
    "                            )\n",
    "                            transformed_queries = result.queries\n",
    "                            cache_hit = result.cache_hit\n",
    "                            model_name = result.model\n",
    "                            prompt_version = result.prompt_version\n",
    "                        elif strategy == \"multi_query\":\n",
    "                            result = multi_query(\n",
    "                                llm_client=llm_client,\n",
    "                                question=target.question,\n",
    "                                model=query_rewrite_model_name,\n",
    "                                timeout_seconds=CONFIG.timeout_seconds,\n",
    "                                cache=rewrite_caches[strategy],\n",
    "                                n=MULTI_QUERY_N,\n",
    "                                prompt_version=QUERY_REWRITING_PROMPT_VERSION,\n",
    "                            )\n",
    "                            transformed_queries = result.queries\n",
    "                            cache_hit = result.cache_hit\n",
    "                            model_name = result.model\n",
    "                            prompt_version = result.prompt_version\n",
    "                        else:\n",
    "                            raise ValueError(f\"Unsupported query rewriting strategy: {strategy}\")\n",
    "\n",
    "                        candidates = retrieve_query_variants(\n",
    "                            client=qdrant_client,\n",
    "                            collection_name=collection_name,\n",
    "                            embedder=embedder,\n",
    "                            query_texts=transformed_queries,\n",
    "                            limit=base_top_k,\n",
    "                            retrieval_mode=\"hybrid\",\n",
    "                            static_filters={},\n",
    "                            rrf_k=base_rrf_k,\n",
    "                            index_manifest=index_manifest,\n",
    "                        )\n",
    "                        row = evaluate_query_rewrite(\n",
    "                            target=target,\n",
    "                            retrieved=candidates,\n",
    "                            retrieval_mode=\"hybrid\",\n",
    "                            top_k=base_top_k,\n",
    "                            rrf_k=base_rrf_k,\n",
    "                            filter_name=\"none\",\n",
    "                            metadata_filters={},\n",
    "                            strategy=strategy,\n",
    "                            rewritten_queries=transformed_queries,\n",
    "                            query_rewriting_model=model_name,\n",
    "                            query_rewriting_prompt_version=prompt_version,\n",
    "                            cache_hit=cache_hit,\n",
    "                        ).to_json_record()\n",
    "                        row[\"dataset\"] = dataset\n",
    "                        row.update(_answer_overlap_metrics(target, candidates, prefix=\"direct\"))\n",
    "                        query_rewrite_rows.append(row)\n",
    "                        if strategy != \"none\":\n",
    "                            query_rewrite_cache_hits += int(cache_hit)\n",
    "                            query_rewrite_cache_misses += int(not cache_hit)\n",
    "                            if len(query_rewrite_examples) < 3:\n",
    "                                query_rewrite_examples.append({\n",
    "                                    \"dataset\": dataset,\n",
    "                                    \"qid\": target.qid,\n",
    "                                    \"strategy\": strategy,\n",
    "                                    \"question\": target.question,\n",
    "                                    \"transformed_queries\": transformed_queries,\n",
    "                                })\n",
    "                    except Exception as exc:\n",
    "                        query_rewrite_failures.append({\n",
    "                            \"dataset\": dataset,\n",
    "                            \"qid\": target.qid,\n",
    "                            \"strategy\": strategy,\n",
    "                            \"error\": f\"{type(exc).__name__}: {exc}\",\n",
    "                        })\n",
    "        if query_rewrite_failures:\n",
    "            query_rewrite_failure_rate = len(query_rewrite_failures) / max(1, len(query_rewrite_failures) + query_rewrite_cache_hits + query_rewrite_cache_misses)\n",
    "            display(pd.DataFrame(query_rewrite_failures).head(20))\n",
    "            if query_rewrite_failure_rate > QUERY_REWRITING_FAILURE_RATE_WARN_THRESHOLD:\n",
    "                message = f\"Query rewriting structured-output failures above threshold: {query_rewrite_failure_rate:.1%}\"\n",
    "                if QUERY_REWRITING_STRICT_FAILURES:\n",
    "                    raise RuntimeError(message)\n",
    "                display(Markdown(f\"**Warning:** {message}. I risultati query rewriting restano salvati ma non vanno promossi senza una run stabile.\"))\n",
    "        mark_experiment(\n",
    "            \"query_rewriting\",\n",
    "            status=\"run\" if query_rewrite_rows else \"skipped\",\n",
    "            reason=\"\" if query_rewrite_rows else \"No query rewriting rows produced\",\n",
    "            rows=len(query_rewrite_rows),\n",
    "            extra={\"cache_hits\": query_rewrite_cache_hits, \"cache_misses\": query_rewrite_cache_misses},\n",
    "        )\n",
    "else:\n",
    "    mark_experiment(\"query_rewriting\", status=\"skipped\", reason=\"RUN_QUERY_REWRITING=False\")\n",
    "\n",
    "query_rewrite_df = pd.DataFrame(query_rewrite_rows)\n",
    "if query_rewrite_df.empty:\n",
    "    display_experiment_card(\"Esperimento H - Query rewriting\", status=\"skipped\", metric=\"article_hit@k\", note=\"Impostare RUN_QUERY_REWRITING=True per eseguire il pilot cache-aware.\")\n",
    "else:\n",
    "    query_rewrite_summary = (\n",
    "        query_rewrite_df.groupby([\"dataset\", \"strategy\", \"retrieval_mode\", \"top_k\", \"rrf_k\"], dropna=False)\n",
    "        .agg(\n",
    "            questions=(\"qid\", \"nunique\"),\n",
    "            article_hit=(\"direct_article_hit\", \"mean\"),\n",
    "            law_hit=(\"direct_law_hit\", \"mean\"),\n",
    "            article_mrr=(\"direct_article_mrr\", \"mean\"),\n",
    "            cache_hit_rate=(\"cache_hit\", \"mean\"),\n",
    "            avg_transformed_queries=(\"transformed_query_count\", \"mean\"),\n",
    "        )\n",
    "        .reset_index()\n",
    "    )\n",
    "    display_experiment_card(\n",
    "        \"Esperimento H - Query rewriting\",\n",
    "        status=\"run\",\n",
    "        metric=\"article_hit@k post-rewrite\",\n",
    "        config={\"prompt_version\": QUERY_REWRITING_PROMPT_VERSION, \"strategies\": QUERY_REWRITING_STRATEGIES},\n",
    "    )\n",
    "    display(query_rewrite_summary.sort_values([\"dataset\", \"article_hit\", \"article_mrr\", \"strategy\"], ascending=[True, False, False, True]))\n",
    "    display(Markdown(f\"Query rewriting cache: hits={query_rewrite_cache_hits}, misses={query_rewrite_cache_misses}\"))\n",
    "    if query_rewrite_examples:\n",
    "        display(Markdown(\"**Esempi qualitativi trasformazioni:**\"))\n",
    "        display(pd.DataFrame(query_rewrite_examples))\n"
   ]
