    "            \"simple_errors\": simple_metrics.get(\"errors\"),\n",
    "            \"advanced_errors\": advanced_metrics.get(\"errors\"),\n",
    "            \"simple_coverage\": simple_metrics.get(\"coverage\"),\n",
    "            \"advanced_coverage\": advanced_metrics.get(\"coverage\"),\n",
