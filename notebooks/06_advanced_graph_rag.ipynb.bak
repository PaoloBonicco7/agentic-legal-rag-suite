   "outputs": [],
   "source": [
    "PREVIOUS_ADVANCED_RUN_NAME = \"full_100_dense_graph_rerank\"\n",
    "PREVIOUS_ADVANCED_RUN_DIR = ADVANCED_ROOT / PREVIOUS_ADVANCED_RUN_NAME\n",
    "previous_advanced_summary_path = PREVIOUS_ADVANCED_RUN_DIR / \"advanced_rag_summary.json\"\n",
    "previous_advanced_manifest_path = PREVIOUS_ADVANCED_RUN_DIR / \"advanced_rag_manifest.json\"\n",
    "\n",
    "if not simple_summary:\n",
    "    print(\"Simple RAG summary non trovato: impossibile costruire il confronto.\")\n",
    "elif not previous_advanced_summary_path.exists():\n",
    "    print(f\"Run advanced precedente non trovata: {PREVIOUS_ADVANCED_RUN_DIR}\")\n",
    "else:\n",
    "    previous_advanced_summary = read_json(previous_advanced_summary_path)\n",
