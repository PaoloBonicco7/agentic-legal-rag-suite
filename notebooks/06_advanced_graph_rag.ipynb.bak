    "    ax.bar([i - 0.18 for i in x], simple_values, width=0.36, label=\"Simple RAG\", color=\"#9aa0a6\")\n",
    "    ax.bar([i + 0.18 for i in x], advanced_values, width=0.36, label=\"Advanced precedente\", color=\"#2f6f9f\")\n",
